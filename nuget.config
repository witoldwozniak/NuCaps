<?xml version="1.0" encoding="utf-8"?>
<!--
  Controls where packages are allowed to come from.

  Without this file, NuGet inherits whatever sources are configured on the machine
  that runs the build. That means a build can be redirected by configuration this
  repository does not contain and cannot see. For a project about supply-chain risk,
  the sources have to be stated here.
-->
<configuration>

  <packageSources>
    <!-- Drop every inherited source, then name the only one this project uses. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    A machine-level file can disable a source as well as add one. Clearing the list
    stops an inherited entry from switching nuget.org off, which would otherwise fail
    the restore with a message that does not name the real cause.
  -->
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>

  <!--
    Package source mapping says which source each package may come from. With a single
    source it prevents nothing today, because every package already resolves from
    nuget.org. It is here for what happens next: once mapping is on, NuGet refuses to
    restore from any source that has no mapping. So a second source added later, by
    anyone, is inert until someone deliberately writes down what it is allowed to serve.
    That is the moment the protection matters, and this file has to exist before it.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
