#!/usr/bin/env bash
#
# Sets up a fresh clone for development. Run it once after cloning. Running it
# again is safe and does nothing new.
#
#   script/bootstrap
#
# This follows the "Scripts to Rule Them All" convention: one script a newcomer
# can run without knowing anything about the stack.

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

step() { printf '\n==> %s\n' "$1"; }
note() { printf '    %s\n' "$1"; }

fail() {
  printf '\nSetup stopped: %s\n' "$1" >&2
  exit 1
}

step "Checking the .NET software development kit"

if ! command -v dotnet >/dev/null 2>&1; then
  note "dotnet was not found on your PATH."
  fail "install the .NET 10 software development kit from https://dotnet.microsoft.com/download"
fi

# global.json pins the version this project builds with. If the installed one
# does not satisfy that pin, dotnet says so itself, and its message names both
# the required version and what you have. Reprinting it beats parsing it.
if ! sdk_version="$(dotnet --version 2>&1)"; then
  printf '%s\n' "$sdk_version" >&2
  fail "the installed software development kit does not satisfy global.json"
fi

note "Using .NET $sdk_version"

step "Pointing git at this repository's hooks"

# Git does not share hooks, because .git/hooks is not committed. This is the one
# step that cannot be skipped: without it, the commit message check never runs,
# and force pushes are blocked on main, so a bad message there is permanent.
git config core.hooksPath .githooks
note "core.hooksPath is now .githooks"
note "Commit messages are checked against the convention in AGENTS.md."

step "Restoring packages"

dotnet restore

# Succeeds when direnv has already been told to trust this .envrc, where 0 means
# allowed. The JSON output is read first because its field names are stable across
# versions, while the human-readable text is not. The text is only a fallback for a
# direnv too old to understand --json.
#
# Read foundRC, and only foundRC. The same document also carries loadedRC, which
# describes whatever .envrc the current shell has already loaded, and that is usually
# a different file. Somebody who uses direnv elsewhere and runs this from a shell
# still holding another project's environment gets "loadedRC": {"allowed": 0} sitting
# next to "foundRC": {"allowed": 1}. A search across the whole document finds that
# other zero and reports this .envrc as trusted when it is not. Whitespace is stripped
# first so the match holds whether or not direnv pretty-prints the document.
#
# Anything this cannot read counts as not allowed, so an unclear answer prints the
# reminder. Printing a reminder you do not need wastes a moment. Skipping one you do
# need leaves the telemetry opt-out silently switched off, which is the failure that
# matters here.
envrc_is_allowed() {
  local status_output found_rc
  if status_output="$(direnv status --json 2>/dev/null)"; then
    found_rc="$(tr -d '[:space:]' <<<"$status_output" | grep -o '"foundRC":{[^}]*}')" || return 1
    [[ "$found_rc" == *'"allowed":0'* ]]
    return
  fi
  direnv status 2>/dev/null | grep -qE '^Found RC allowed 0$'
}

if [[ -f .envrc ]]; then
  if ! command -v direnv >/dev/null 2>&1; then
    step "One step is left for you"
    note "This project ships a .envrc that opts out of .NET and test platform telemetry."
    note "Install direnv to use it, or export those variables yourself."
  elif envrc_is_allowed; then
    step "Checking the environment"
    note ".envrc is already allowed. Nothing to do."
  else
    step "One step is left for you"
    note "Run: direnv allow"
    note "That loads .envrc, which opts this project out of .NET and test platform telemetry."
    note "It cannot be automated. Allowing a .envrc is a trust decision, and a"
    note "setup script that made it for you would defeat the point of direnv."
  fi
fi

step "Ready"
note "Run every check with: script/check"
note "That is the same command continuous integration runs. It needs ShellCheck installed."
